nextflow_process {

    name "Test Process EXTRACT_PROTEINS"
    script "modules/local/algo/extract_proteins.nf"
    process "EXTRACT_PROTEINS"

    test("Should extract protein sequences with gffread -y -J") {

        when {
            process {
                """
                input[0] = Channel.of( [
                    "TinySpecies",
                    file("${projectDir}/data/algo_test_input/tiny_genome.fa"),
                    file("${projectDir}/data/algo_test_input/tiny_genome.gff3")
                ] )
                """
            }
        }

        then {
            assert process.success
            assert process.trace.tasks().size() == 1
            with(process.out) {
                assert proteins.size() == 1
                assert proteins[0][0] == "TinySpecies"
                // Filename is "<sample_id>.fa" (single dot), not "<sample_id>.protein.fa" --
                // OrthoFinder derives each species name by stripping only the last
                // extension, so a second dot would break that downstream.
                assert path(proteins[0][1]).getFileName().toString() == "TinySpecies.fa"
                // Fixture has two genes: "clean_gene" has a complete ORF and must survive;
                // "broken_gene" has a deliberate premature in-frame stop codon and must be
                // dropped entirely by -J (the fix for the real diamond/OrthoFinder crash on
                // an in-frame-stop translation containing a literal "."). Asserting on
                // content rather than just the md5, so a future reader can see what this
                // is actually guarding without needing to decode the fixture by hand.
                def fasta_text = path(proteins[0][1]).text
                assert fasta_text.contains(">mrna_clean_gene")
                assert fasta_text.contains("MARNDCQEG")
                assert !fasta_text.contains("broken_gene")
                assert !fasta_text.contains(".")
                assert path(proteins[0][1]).md5 == '655a527e776920865588a63bf204e6fe'
            }
        }
    }
}
