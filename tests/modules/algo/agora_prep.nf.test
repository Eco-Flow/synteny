nextflow_process {

    name "Test Process AGORA_PREP"
    script "modules/local/algo/agora_prep.nf"
    process "AGORA_PREP"

    test("Should build AGORA gene lists, orthology groups and labelled tree") {

        when {
            process {
                """
                input[0] = Channel.of(
                    file("${projectDir}/data/algo_test_input/SpeciesA.filtered.tsv"),
                    file("${projectDir}/data/algo_test_input/SpeciesB.filtered.tsv"),
                    file("${projectDir}/data/algo_test_input/SpeciesC.filtered.tsv")
                ).collect()
                input[1] = file("${projectDir}/data/algo_test_input/tiny_tree.nwk")
                """
            }
        }

        then {
            assert process.success
            assert process.trace.tasks().size() == 1
            with(process.out) {
                assert agora_input.size() == 1
                def dir = agora_input[0]
                // AGORA needs one orthologyGroups file per internal (ancestor) node,
                // each restricted to that node's descendant species -- not one flat
                // file (confirmed against a real AGORA run). Tree: (SpeciesA,SpeciesB)
                // AlgoAnc1, (AlgoAnc1,SpeciesC) AlgoAnc2 (root). 1004at7147 is a
                // SpeciesA-only singleton and is correctly excluded everywhere; the
                // other 4 BUSCO ids are shared by all 3 species.
                assert path("${dir}/orthologyGroups/orthologyGroups.AlgoAnc1.list").md5 == '7b3d40a57b702c96e667522b80c386f4'
                assert path("${dir}/orthologyGroups/orthologyGroups.AlgoAnc2.list").md5 == '45a9b1344622900bf2053f24a571cad4'
                // Unnamed internal nodes get auto-labelled (AlgoAnc1, AlgoAnc2), with
                // their branch length preserved.
                assert path("${dir}/species_tree.nwk").md5 == 'b3b349fcbf1e662aa270e9a89bd04fdc'
                assert path("${dir}/genes/genes.SpeciesA.list").md5 == '300647a6ea2415a3e7367196f86e99a3'
                assert path("${dir}/genes/genes.SpeciesB.list").md5 == 'e22f43164ea08e96719632d1f5838eeb'
                assert path("${dir}/genes/genes.SpeciesC.list").md5 == '2e6c9ba3e4f258d9bcefd4c0d0cde65d'
            }
        }
    }

    test("Should relabel internal nodes carrying only a branch-support value") {

        when {
            process {
                """
                input[0] = Channel.of(
                    file("${projectDir}/data/algo_test_input/SpeciesA.filtered.tsv"),
                    file("${projectDir}/data/algo_test_input/SpeciesB.filtered.tsv"),
                    file("${projectDir}/data/algo_test_input/SpeciesC.filtered.tsv")
                ).collect()
                input[1] = file("${projectDir}/data/algo_test_input/tiny_tree_with_support.nwk")
                """
            }
        }

        then {
            assert process.success
            with(process.out) {
                def dir = agora_input[0]
                // Same topology as tiny_tree.nwk, but the internal node carries an
                // IQ-TREE-style "97.3/100" SH-aLRT/UFBoot support value instead of
                // being blank -- root_tree.py re-emits real support values exactly
                // like this. A support value labels a bipartition, not a node, so it
                // must still be replaced with AlgoAnc1 (regression test: previously
                // this was mistaken for a real node name and left alone, which made
                // AGORA's own tree loader invent a mismatched "NAME_0" placeholder
                // that this script had no matching orthologyGroups file for --
                // https://github.com/Eco-Flow/synteny, AGORA FileNotFoundError on
                // orthologyGroups.NAME_0.list). Output is byte-identical to the blank
                // case above.
                assert path("${dir}/species_tree.nwk").md5 == 'b3b349fcbf1e662aa270e9a89bd04fdc'
                assert path("${dir}/orthologyGroups/orthologyGroups.AlgoAnc1.list").md5 == '7b3d40a57b702c96e667522b80c386f4'
                assert path("${dir}/orthologyGroups/orthologyGroups.AlgoAnc2.list").md5 == '45a9b1344622900bf2053f24a571cad4'
            }
        }
    }
}
