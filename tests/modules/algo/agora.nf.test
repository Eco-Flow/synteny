nextflow_process {

    name "Test Process AGORA"
    script "modules/local/algo/agora.nf"
    process "AGORA"

    test("Should reconstruct ancestral gene order from a real AGORA_PREP-shaped input") {

        when {
            process {
                """
                input[0] = file("${projectDir}/data/algo_test_input/agora_input_fixture")
                """
            }
        }

        then {
            assert process.success
            with(process.out) {
                assert ancestral_output.size() == 1
                def dir = ancestral_output[0]
                // AlgoAnc2 is the tree's root (SpeciesA,SpeciesB)AlgoAnc1,SpeciesC)AlgoAnc2;
                // -- AGORA reconstructs an ancGenome at every internal node, so both
                // the root and the intermediate AlgoAnc1 ancestor get one.
                assert path("${dir}/ancGenomes/generic-workflow/ancGenome.AlgoAnc1.list.bz2").exists()
                assert path("${dir}/ancGenomes/generic-workflow/ancGenome.AlgoAnc2.list.bz2").exists()
            }
        }
    }
}
