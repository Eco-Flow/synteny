nextflow_process {

    name "Test Process EXTRACT_SINGLE_COPY"
    script "modules/local/algo/extract_single_copy.nf"
    process "EXTRACT_SINGLE_COPY"

    test("Should extract single-copy orthogroups as per-species FASTA files") {

        when {
            process {
                """
                input[0] = file("${projectDir}/data/algo_test_input/orthofinder_output_fixture")
                input[1] = Channel.of(
                    file("${projectDir}/data/algo_test_input/tree_proteomes/SpeciesA.fa"),
                    file("${projectDir}/data/algo_test_input/tree_proteomes/SpeciesB.fa"),
                    file("${projectDir}/data/algo_test_input/tree_proteomes/SpeciesC.fa"),
                    file("${projectDir}/data/algo_test_input/tree_proteomes/SpeciesD.fa")
                ).collect()
                """
            }
        }

        then {
            assert process.success
            assert process.trace.tasks().size() == 1
            with(process.out) {
                assert orthogroups.size() == 1
                // All 4 orthogroups in the fixture Orthogroups.tsv are single-copy and
                // complete across all 4 species (see data/algo_test_input/tree_proteomes/).
                assert path("${orthogroups[0]}/OG0000000.fa").md5 == 'e3495a84d1229180b0136c1ad9c3c298'
            }
        }
    }

    test("Should match a gene ID that OrthoFinder sanitised for Newick safety") {

        when {
            process {
                """
                input[0] = file("${projectDir}/data/algo_test_input/orthofinder_output_fixture_colon_ids")
                input[1] = Channel.of(
                    file("${projectDir}/data/algo_test_input/colon_id_proteomes/SpeciesE.fa"),
                    file("${projectDir}/data/algo_test_input/colon_id_proteomes/SpeciesF.fa")
                ).collect()
                """
            }
        }

        then {
            assert process.success
            with(process.out) {
                // SpeciesE's real header is ">transcript:ENSXXXT00000001", but
                // OrthoFinder writes ":" as "_" in Orthogroups.tsv (colons have special
                // meaning in Newick format, which OrthoFinder embeds sequence IDs into)
                // -- confirmed against a real run mixing Ensembl-derived (colon-bearing)
                // and BRAKER-derived (plain) proteomes. Without sanitising the raw
                // header the same way before comparing, this lookup silently fails.
                assert orthogroups.size() == 1
                def fasta_text = path("${orthogroups[0]}/OG0000000.fa").text
                assert fasta_text.contains(">SpeciesE")
                assert fasta_text.contains("MARNDCQEG")
                assert fasta_text.contains(">SpeciesF")
                assert fasta_text.contains("MHDCILDAR")
            }
        }
    }
}
