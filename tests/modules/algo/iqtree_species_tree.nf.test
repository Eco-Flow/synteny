nextflow_process {

    name "Test Process IQTREE (species tree, edge-proportional partitions)"
    script "modules/nf-core/iqtree/main.nf"
    process "IQTREE"

    test("Should infer a species tree from the supermatrix under the partition model") {

        config "./iqtree_species_tree.config"

        when {
            process {
                """
                input[0]  = [ [id: "algo_species_tree"],
                    file("${projectDir}/data/algo_test_input/supermatrix_fixture.faa"),
                    [] ]
                input[1]  = []
                input[2]  = []
                input[3]  = []
                input[4]  = []
                input[5]  = file("${projectDir}/data/algo_test_input/partitions_fixture.txt")
                input[6]  = []
                input[7]  = []
                input[8]  = []
                input[9]  = []
                input[10] = []
                input[11] = []
                input[12] = []
                """
            }
        }

        then {
            assert process.success
            with(process.out) {
                assert phylogeny.size() == 1
                def tips = ["SpeciesA", "SpeciesB", "SpeciesC", "SpeciesD"]
                def tree_text = path(phylogeny[0][1]).text
                tips.each { sp -> assert tree_text.contains(sp) }
            }
        }
    }
}
