nextflow_process {

    name "Test Process ORTHOFINDER_V2"
    script "modules/local/algo/orthofinder_v2.nf"
    process "ORTHOFINDER_V2"

    test("Should call orthogroups across the 4 tiny synthetic proteomes") {

        when {
            params {
                orthofinder_args = "-M dendroblast"
            }
            process {
                """
                input[0] = Channel.of(
                    file("${projectDir}/data/algo_test_input/tree_proteomes/SpeciesA.fa"),
                    file("${projectDir}/data/algo_test_input/tree_proteomes/SpeciesB.fa"),
                    file("${projectDir}/data/algo_test_input/tree_proteomes/SpeciesC.fa"),
                    file("${projectDir}/data/algo_test_input/tree_proteomes/SpeciesD.fa")
                ).collect()
                """
            }
        }

        then {
            assert process.success
            with(process.out) {
                assert orthologues.size() == 1
                // og1-og4 are shared by all 4 species (the "_specific" gene in each
                // fixture proteome is not, and is correctly absent below). Unlike
                // ORTHOFINDER (v3, tests/modules/algo/orthofinder.nf.test), which splits
                // these into 4 separate single-copy orthogroups on this fixture, 2.5.5's
                // dendroblast clustering is coarser here and lumps all 4 into one
                // orthogroup -- a real, version-specific clustering-sensitivity
                // difference on this small synthetic fixture, not a wiring bug. Assert
                // on structure (species present, genes correctly grouped/excluded)
                // rather than the exact row count.
                def lines = path(orthologues[0]).text.readLines()
                assert lines[0].split('\t')[1..-1] as Set == ["SpeciesA", "SpeciesB", "SpeciesC", "SpeciesD"] as Set
                assert lines.size() >= 2 // header + at least one orthogroup
                ["SpeciesA", "SpeciesB", "SpeciesC", "SpeciesD"].each { sp ->
                    assert lines[1..-1].any { it.contains("${sp}_og1") }
                    assert !lines[1..-1].any { it.contains("${sp}_specific") }
                }
            }
        }
    }
}
