nextflow_process {

    name "Test Process SUMMARISE_BOOTSTRAP_SUPPORT"
    script "modules/local/algo/summarise_bootstrap_support.nf"
    process "SUMMARISE_BOOTSTRAP_SUPPORT"

    test("Should compute per-marker ALG support fraction across bootstrap replicates") {

        when {
            process {
                """
                input[0] = file("${projectDir}/data/algo_test_input/algo_table_fixture.tsv")
                input[1] = Channel.of(
                    file("${projectDir}/data/algo_test_input/bootstrap_replicate1.table.tsv"),
                    file("${projectDir}/data/algo_test_input/bootstrap_replicate2.table.tsv")
                ).collect()
                """
            }
        }

        then {
            assert process.success
            assert process.trace.tasks().size() == 1
            with(process.out) {
                assert support.size() == 1
                // Reference fixture (algo_table_fixture.tsv, see summarise_alg_table.nf.test)
                // has node n1 split into two ALGs: n1_1 = {1000,1001,1002at7147},
                // n1_2 = {1003at7147}. bootstrap_replicate1 drops 1002at7147 (simulating
                // it wasn't resampled) but otherwise agrees with the reference split under
                // its own (arbitrary) labels. bootstrap_replicate2 merges everything into
                // one group, disagreeing with the reference split of 1003at7147 into its
                // own ALG.
                // Expected support: 1000/1001at7147 fully supported (2/2 replicates that
                // saw them agreed); 1002at7147 only appears in replicate2 but agrees there
                // (1/1); 1003at7147 appears in both replicates but only agrees in
                // replicate1, since replicate2's merge maps to the larger n1_1 group (1/2).
                assert path(support[0]).md5 == '95a6b846495a7d22b4b028b75f77e0e9'
            }
        }
    }
}
