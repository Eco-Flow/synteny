manifest {
  description = 'Synteny analysis' 
  author = 'Chris Wyatt and Simon Murray'
  version = '4.1.0'
  nextflowVersion = '>=26.04.0'
}

// Defaults parameters, expecting to be overwritten
params {
  // Path to results directory
  outdir                     = "results"
  // Path to input CSV
  input                      = null
  hex                        = "s3://synteny-test-data/data/unique_hex"
  go                         = null
  tree                       = null
  ribbon                     = null
  score                      = null
  chromopaint                = false
  lifted                     = true
  cutoff                     = "10,20"
  cutoffdistance             = "1,3"
  gffread_coding             = null
  jcvi_ortholog_arguments    = "--no_strip_names"
  jcvi_screen_arguments      = "--minspan 20"
  // Remove work directories upon pipeline completion
  clean                      = false
  // Architecture of platform pipeline is running on
  architecture               = "amd"
  // include basic config
  custom_config              = null
  // Display help message with nf-validation
  help = null
  // nf-core module parameters
  publish_dir_mode           = 'copy'
  seqkit_basename     = null
  seqkit_fq_encoding  = null
  seqkit_gap_letters  = null
  chromo_lengths             = false
  proportional_chromosomes   = false
  // Suffix (timestamp) for the trace/report/timeline/dag files
  timestamp                  = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

  // ALGO subworkflow (--mode algo): ancestral linkage groups (Syngraph) and
  // ancestral gene order (AGORA) reconstruction from BUSCO single-copy orthologues
  mode                       = null
  species_tree               = null
  busco_lineage              = null
  busco_container            = 'ezlabgva/busco:v6.0.0_cv1'
  exclude_scaffolds          = null
  syngraph_m                 = 10
  syngraph_r                 = 2
  syngraph_reference         = null
  syngraph_container         = 'synteny-syngraph:local'
  agora_container            = 'synteny-agora:local'
  agora_ancgenome_glob       = '**/ancGenome*'

  // Optional --iqtree_species_tree: build the species tree with OrthoFinder + IQ-TREE
  // instead of supplying one via --species_tree (see workflows/algo.nf)
  iqtree_species_tree        = false
  iqtree_outgroup            = null
  iqtree_args                = null
  iqtree_partition_model     = 'AA'
  mafft_args                 = '--auto'
  orthofinder_args           = '-M dendroblast'
}

plugins {
  id 'nf-co2footprint@1.4.0'
  id 'nf-schema@2.7.3'
  // nf-amazon is left unpinned so it tracks the version bundled with Nextflow
  id 'nf-amazon'
}

co2footprint {
    trace {
        file = "${params.outdir}/pipeline_info/co2_emissions/co2footprint_trace_${params.timestamp}.txt"
    }
    report {
        file = "${params.outdir}/pipeline_info/co2_emissions/co2footprint_report_${params.timestamp}.html"
    }
    summary {
        file = "${params.outdir}/pipeline_info/co2_emissions/co2footprint_summary_${params.timestamp}.txt"
    }
    provenance {
        file = "${params.outdir}/pipeline_info/co2_emissions/co2footprint_provenance_${params.timestamp}.json"
    }
    ci          = 300
    pue         = 1.4
    machineType = 'local'
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load custom config if provided
includeConfig params.custom_config ? "${params.custom_config}" : '/dev/null'

// Select a combination of useful profiles i.e. nextflow run -profile local,docker 
profiles {
  aws_batch {
    includeConfig 'conf/aws_batch.config'
  }
  debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
  }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda', 'defaults']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gitpod {
        executor.name           = 'local'
        executor.cpus           = 4
        executor.memory         = 8.GB
    }
  test           { includeConfig 'conf/test.config'           }
  test_full      { includeConfig 'conf/test_full.config'      }
  test_mammal    { includeConfig 'conf/test_mammal.config'    }
  test_halictids { includeConfig 'conf/test_halictids.config' }
  test_algo      { includeConfig 'conf/test_algo.config'      }
}

// Load nf-core modules config
includeConfig 'conf/modules.config'

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Capturing Nextflow log files into a rsults/pipeline_info directory
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.timestamp}.html"
}

// Ensures work directories and removed when pipeline completes
cleanup = params.clean
