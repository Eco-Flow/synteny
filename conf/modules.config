/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

//
// General configuration options
//

process {

    withName: 'CUSTOM_DUMPSOFTWAREVERSIONS' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*_versions.yml'
        ]
    }

    withName: 'RIBBON' {
        publishDir = [
            [
                path: { "${params.outdir}/figures/ribbon" },
                mode: params.publish_dir_mode,
                pattern: "*.pdf"
            ],
            [
                path: { "${params.outdir}/figures/ribbon" },
                mode: params.publish_dir_mode,
                pattern: "*.svg"
            ],
            [
                path: { "${params.outdir}/figures/ribbon" },
                mode: params.publish_dir_mode,
                pattern: "chromosome_name_legend.tsv"
            ]
        ]
    }

    withName: 'SEQKIT_STATS' {
        ext.args   = { [
                    params.seqkit_basename         != null ? "--basename" : '',
                    params.seqkit_fq_encoding      ? "--fq-encoding string='${params.seqkit_fq_eneconding}'" : '',
                    params.seqkit_gap_letters      ? "--gap-letters='${params.seqkit_gap_letters}'" : ''
            ].join(' ').trim() }
    }

    withName: 'LONGEST' {
        memory = { 32.GB * task.attempt }
    }

    withName: 'GFFREAD' {
        ext.args   = { [
                    params.gffread_coding         != null ? "-C" : '',
            ].join(' ').trim() }
    }

    //
    // ALGO subworkflow (--mode algo)
    // (SYNGRAPH, AGORA and FRAGMENTATION_INDEX declare their own publishDir
    // inline, matching the SYNTENY/GO convention; BUSCO doesn't, matching
    // the RIBBON/nf-core-module convention, so it's set here instead)
    //

    withName: 'BUSCO' {
        publishDir = [
            path: { "${params.outdir}/algo/busco" },
            mode: params.publish_dir_mode,
            pattern: "*.full_table.tsv"
        ]
    }

    //
    // ALGO subworkflow, --iqtree_species_tree path (OrthoFinder + IQ-TREE)
    // (EXTRACT_PROTEINS, CONCAT_SINGLE_COPY and ROOT_TREE declare their own
    // publishDir inline; ORTHOFINDER, EXTRACT_SINGLE_COPY and ALIGN_SINGLE_COPY
    // don't, so it's set here instead, matching the BUSCO/RIBBON convention)
    //

    withName: 'ORTHOFINDER' {
        // Default (-M dendroblast) skips OrthoFinder's own MSA-based gene-tree/species-tree
        // inference: only Orthogroups.tsv is used below, and dendroblast is both faster and
        // avoids a famsa dependency issue seen with the MSA-based default method.
        ext.args   = params.orthofinder_args
        publishDir = [
            path: { "${params.outdir}/algo/orthofinder" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'ORTHOFINDER_V2' {
        // Reads params.orthofinder_args directly in-script rather than via ext.args
        // (a local module, not a vendored one -- see modules/local/algo/orthofinder_v2.nf)
        publishDir = [
            path: { "${params.outdir}/algo/orthofinder" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'EXTRACT_SINGLE_COPY' {
        publishDir = [
            path: { "${params.outdir}/algo/species_tree/single_copy_orthogroups" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SELECT_ORTHOGROUPS' {
        publishDir = [
            path: { "${params.outdir}/algo/species_tree/selected_orthogroups" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'ALIGN_SINGLE_COPY' {
        ext.args = params.mafft_args
        publishDir = [
            path: { "${params.outdir}/algo/species_tree/single_copy_alignments" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'IQTREE_SPECIES_TREE' {
        cpus       = { 8     * task.attempt }
        memory     = { 16.GB * task.attempt }
        time       = { 24.h  * task.attempt }
        ext.prefix = 'species_tree'
        // The partition file is passed as -spp (edge-proportional partition model), -m MFP
        // selects a model per partition, and -B/--alrt give ultrafast bootstrap and SH-aLRT
        // support. A model fixed via --iqtree_partition_model or named in --iqtree_args must
        // not be overridden by the default -m MFP, since IQ-TREE rejects a second -m
        // alongside a partition file.
        ext.args   = {
            def extra      = params.iqtree_args ?: ''
            def part_model = params.iqtree_partition_model ?: 'AA'
            def has_model  = extra.startsWith('-m ') || extra.contains(' -m ') || part_model != 'AA'
            def model      = has_model ? '' : '-m MFP '
            return "${model}-B 1000 --alrt 1000 --quiet${extra ? ' ' + extra : ''}"
        }
        publishDir = [
            path: { "${params.outdir}/algo/species_tree/iqtree" },
            mode: params.publish_dir_mode
        ]
    }
}
