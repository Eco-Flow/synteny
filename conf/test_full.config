params {
  // Path to test input data
  input                      = "${projectDir}/data/Example-local.csv"
  go                         = "${projectDir}/data/go_input/hash_files"
  score                      = true
  clean                      = false
  ribbon                     = "Drosophila_santomea,Drosophila_simulans,Drosophila_yakuba"
}

// Max resources for the test data can be reduced
process {
  resourceLimits = [ cpus: 2, memory: 6.GB, time: 6.h ]
}
