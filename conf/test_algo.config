params {
  // ALGO subworkflow smoke-test profile. Reuses the same small local
  // Drosophila genomes as conf/test.config, purely to exercise the pipeline
  // mechanics end-to-end (this is not a biological claim -- Coleoptera is the
  // actual target lineage of the --busco_lineage this subworkflow was built
  // to replicate; diptera_odb10 is used here only because it is a smaller,
  // faster BUSCO dataset that matches the test genomes' phylogeny).
  mode                = "algo"
  input               = "${projectDir}/data/Example-local.csv"
  species_tree        = "${projectDir}/data/algo_test_input/drosophila_test_tree.nwk"
  busco_lineage       = "diptera_odb10"
  syngraph_reference  = "Drosophila_yakuba"
  syngraph_m          = 5
}

// Max resources for the test data can be reduced
process {
  resourceLimits = [ cpus: 2, memory: 6.GB, time: 6.h ]
}
